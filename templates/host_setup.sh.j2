#!/bin/sh
set -e

echo "[INFO] Configuring host {{ host.name }}..."

# Ensure loopback is up
ip link set dev lo up || true

# Wait for eth1 to appear if needed
while ! ip link show eth1 >/dev/null 2>&1; do
    sleep 0.5
done

# Configure IP address and MTU on eth1
ip addr flush dev eth1 || true
ip addr add {{ host.ip }} dev eth1
ip link set dev eth1 mtu {{ fabric.mtu_host }} up

# Add default route via anycast gateway
ip route replace default via {{ host.gateway }} dev eth1

echo "[SUCCESS] {{ host.name }} configured with IP {{ host.ip }} via GW {{ host.gateway }}."
