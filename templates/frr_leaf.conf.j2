frr version 8.4
frr defaults traditional
hostname {{ leaf.name }}
log stdout informational
no ipv6 forwarding
!
interface lo
 ip address {{ leaf.loopback }}
!
interface eth1
 description to_spine1
 ip address {{ leaf.spine1_ip }}/31
 ip mtu {{ fabric.mtu_fabric }}
!
interface eth2
 description to_spine2
 ip address {{ leaf.spine2_ip }}/31
 ip mtu {{ fabric.mtu_fabric }}
!
router bgp {{ leaf.asn }}
 bgp router-id {{ leaf.router_id }}
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 no bgp ebgp-requires-policy
 bgp bestpath as-path multipath-relax
 !
 neighbor {{ leaf.peer_spine1_ip }} remote-as {{ fabric.spine_asn }}
 neighbor {{ leaf.peer_spine1_ip }} description spine1
 neighbor {{ leaf.peer_spine1_ip }} timers 3 9
 neighbor {{ leaf.peer_spine1_ip }} capability extended-nexthop
 !
 neighbor {{ leaf.peer_spine2_ip }} remote-as {{ fabric.spine_asn }}
 neighbor {{ leaf.peer_spine2_ip }} description spine2
 neighbor {{ leaf.peer_spine2_ip }} timers 3 9
 neighbor {{ leaf.peer_spine2_ip }} capability extended-nexthop
 !
 address-family ipv4 unicast
  network {{ leaf.loopback }}
  redistribute connected
  neighbor {{ leaf.peer_spine1_ip }} activate
  neighbor {{ leaf.peer_spine2_ip }} activate
  maximum-paths 64
 exit-address-family
 !
 address-family l2vpn evpn
  neighbor {{ leaf.peer_spine1_ip }} activate
  neighbor {{ leaf.peer_spine2_ip }} activate
  advertise-all-vni
  advertise-default-gw
 exit-address-family
!
router bgp {{ leaf.asn }} vrf {{ fabric.vrf.name }}
 bgp router-id {{ leaf.router_id }}
 !
 address-family ipv4 unicast
  redistribute connected
 exit-address-family
 !
 address-family l2vpn evpn
  advertise ipv4 unicast
 exit-address-family
!
line vty
!
